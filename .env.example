# Configurações do Guardiã AI - Tech Challenge 5

# Provedor de LLM (gemini, openai, ou fallback)
LLM_PROVIDER=gemini

# Chaves de API (opcionais para uso com LLM em nuvem; fallback inteligente opera offline)
GEMINI_API_KEY=sua_chave_gemini_aqui
OPENAI_API_KEY=sua_chave_openai_aqui

# Modelo LLM
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# Configurações de RAG
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
TOP_K_PROTOCOLS=3

# Caminhos de Modelos e Dados
DATA_PATH=./data/processed/dataset_triagem_consolidado.csv
MODEL_PATH=./models/xgboost_model.joblib
PREPROCESSOR_PATH=./models/preprocessor.joblib
METRICS_PATH=./models/metrics_summary.json
AUDIT_LOG_PATH=./logs/audit_trail.jsonl
